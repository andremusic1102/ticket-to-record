# ---------------------------------------------------------------------------
# Data files do not belong in this repository.
#
# This is a hard rule, not a tidiness preference: the extraction work this repo
# demonstrates is also run against private ticket data elsewhere, and that data
# must never reach a public artifact. Blocking the file types by default means
# an accidental `git add .` cannot carry an export along with it.
# ---------------------------------------------------------------------------
*.csv
*.tsv
*.xls
*.xlsx
*.json
*.jsonl
*.ndjson
*.parquet
*.db
*.sqlite
*.sqlite3

# Synthetic examples are the single exception. Everything under examples/ is
# hand-written or generated by this repo's own generator.
!examples/**/*.json
!examples/**/*.jsonl

# Run outputs
runs/
out/

# Secrets
.env
.env.*
!.env.example

# Local red-line term list (see scripts/redline_scan.py)
.redline-terms

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editors / OS
.DS_Store
.idea/
.vscode/
